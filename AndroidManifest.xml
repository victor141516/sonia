<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.sonia.uploader"
    android:versionCode="4"
    android:versionName="1.3">
    <uses-sdk android:minSdkVersion="10" android:targetSdkVersion="10" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- vmSafeMode turns Dalvik's JIT off for this app: on the a6000 the JIT crashed the camera while
         running crypto code. The heavy work (TLS) is native, so the interpreter is fast enough. -->
    <!-- Label and icon must be app resources: Sony's launcher ignores literal labels and framework icons. -->
    <application android:label="@string/app_name" android:icon="@drawable/icon"
        android:vmSafeMode="true">
        <activity android:name=".UploaderActivity"
            android:label="@string/app_name"
            android:icon="@drawable/icon"
            android:theme="@android:style/Theme.Black.NoTitleBar"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".ExitReceiver">
            <intent-filter>
                <action android:name="com.android.server.DAConnectionManagerService.ExitCompleted" />
                <category android:name="ANDROID.INTENT.CATEGORY.DEFAULT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
